  "modules": [
    {
      "id": "module_1_reading",
      "type": "multiple_choice",
      "grading": "automated",
      "sections": [
        {
          "id": "r1",
          "level": "A1-A2",
          "instruction": "Read the text and select the correct option for each question.",
          "text": "Welcome to the Central Metro Station. The ticket office is open daily from 6:00 AM to 10:00 PM. If you need assistance outside these hours, please use the automated ticket machines located next to the main entrance. Passengers must hold a valid ticket before boarding the trains. Backpacks and large luggage are subject to security screening.",
          "questions": [
            {
              "id": "q_1_1",
              "text": "What should a passenger do if the ticket office is closed at 11:00 PM?",
              "options": [
                { "id": "opt_a", "text": "Wait until the next morning at 6:00 AM.", "points": 0 },
                { "id": "opt_b", "text": "Use the automated ticket machines near the main entrance.", "points": 10 },
                { "id": "opt_c", "text": "Board the train immediately and pay inside.", "points": 0 },
                { "id": "opt_d", "text": "Contact security to purchase a special pass.", "points": 0 }
              ]
            },
            {
              "id": "q_1_2",
              "text": "Which items are subject to security checks?",
              "options": [
                { "id": "opt_a", "text": "Only small handbags.", "points": 0 },
                { "id": "opt_b", "text": "All passengers' electronics.", "points": 0 },
                { "id": "opt_c", "text": "Backpacks and large luggage.", "points": 10 },
                { "id": "opt_d", "text": "No items are checked.", "points": 0 }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "module_2_grammar",
      "type": "multiple_choice",
      "grading": "automated",
      "sections": [
        {
          "id": "r2",
          "level": "B1",
          "instruction": "Read the sentence and choose the correct option to fill the gap.",
          "questions": [
            {
              "id": "q_2_1",
              "text": "The company decided to _______ the product launch due to unexpected supply chain issues.",
              "options": [
                { "id": "opt_a", "text": "put up", "points": 0 },
                { "id": "opt_b", "text": "put off", "points": 10 },
                { "id": "opt_c", "text": "put on", "points": 0 },
                { "id": "opt_d", "text": "put out", "points": 0 }
              ]
            },
            {
              "id": "q_2_2",
              "text": "She suggested _______ the new system as soon as possible to avoid security risks.",
              "options": [
                { "id": "opt_a", "text": "to upgrade", "points": 0 },
                { "id": "opt_b", "text": "upgrading", "points": 10 },
                { "id": "opt_c", "text": "upgraded", "points": 0 },
                { "id": "opt_d", "text": "upgrade", "points": 0 }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "module_3_written_precision",
      "type": "text_input",
      "grading": "automated",
      "sections": [
        {
          "id": "wp1",
          "level": "B2",
          "instruction": "Type the exact missing word to complete the sentence.",
          "questions": [
            {
              "id": "b2_write_01",
              "type": "text_input",
              "text": "If I had known you were coming, I _____ have baked a cake.",
              "correctAnswers": ["would", "could"],
              "points": 15
            },
            {
              "id": "b2_write_02",
              "type": "text_input",
              "text": "By the time we arrived at the station, the train had _____ left.",
              "correctAnswers": ["already", "just"],
              "points": 15
            }
          ]
        }
      ]
    },
    {
      "id": "module_4_advanced",
      "type": "cloze",
      "grading": "automated",
      "sections": [
        {
          "id": "c1",
          "level": "C1",
          "instruction": "Read the text and choose the correct word for each blank.",
          "questions": [
            {
              "id": "c1_cloze_01",
              "type": "cloze",
              "text": "The project was ultimately {blank_1} due to funding issues. They had heavily {blank_2} the costs, leading to a severe budget {blank_3}.",
              "blanks": {
                "blank_1": { "options": ["abolished", "scrapped", "destroyed"], "correct": "scrapped", "points": 10 },
                "blank_2": { "options": ["underestimated", "overlooked", "minimized"], "correct": "underestimated", "points": 10 },
                "blank_3": { "options": ["deficit", "surplus", "allowance"], "correct": "deficit", "points": 10 }
              }
            }
          ]
        }
      ]
    }
  ]
